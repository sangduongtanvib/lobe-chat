# Azure Container Deployment Configuration
# This file is pre-configured for Azure deployment

# Proxy, if you need it
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# Azure AI configuration - Configure these in Azure Container Environment Variables
AZURE_API_KEY=${AZURE_API_KEY}
AZURE_API_VERSION=2024-05-01-preview
AZURE_ENDPOINT=${AZURE_ENDPOINT}
AZURE_MODEL_LIST=gpt-4o,gpt-4o-mini,deepSeek-v3,grok-3

# AWS Bedrock configuration - Configure these in Azure Container Environment Variables if needed
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_REGION=us-west-2
AWS_MODEL_LIST=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# Files configuration
DEFAULT_FILES_CONFIG=embedding_model=azure/text-embedding-ada-002,query_mode=full_text

# ===========================
# ====== Preset config ====== 
# ===========================
# Fixed ports for Azure Container deployment
LOBE_PORT=3210
CASDOOR_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
LOGTO_API_PORT=3001
LOGTO_ADMIN_PORT=3002

# Azure Container specific URLs - will be set by environment variables
APP_URL=${APP_URL:-http://localhost:3210}
AUTH_URL=${AUTH_URL:-http://localhost:3210/api/auth}
NEXTAUTH_URL=${NEXTAUTH_URL:-http://localhost:3210}

# Postgres configuration
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-$(openssl rand -base64 32)}

# Casdoor configuration
AUTH_CASDOOR_ISSUER=${AUTH_CASDOOR_ISSUER:-http://localhost:8000}
AUTH_CASDOOR_ID=${AUTH_CASDOOR_ID:-$(openssl rand -hex 12)}
AUTH_CASDOOR_SECRET=${AUTH_CASDOOR_SECRET:-$(openssl rand -hex 16)}

# MinIO S3 configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD:-$(openssl rand -base64 32)}

# S3 configuration - will be configured by environment variables
S3_PUBLIC_DOMAIN=${S3_PUBLIC_DOMAIN:-http://localhost:9000}
S3_ENDPOINT=${S3_ENDPOINT:-http://localhost:9000}
MINIO_LOBE_BUCKET=lobe

# Feature flags
FEATURE_FLAGS=-welcome_suggest,+webrtc_sync,+dalle,+search_engine,+rag_eval,+pin_list

# Casdoor origin
origin=${AUTH_CASDOOR_ISSUER:-http://localhost:8000}
