# Proxy settings (if needed)
# HTTP_PROXY=https://localhost:7890
# HTTPS_PROXY=https://localhost:7890

# ===========================
# ====== Cloud Providers ==== 
# ===========================

# Azure AI configuration - will be configured via setup.sh
AZURE_API_VERSION=2024-05-01-preview
AZURE_MODEL_LIST=gpt-4o,gpt-4o-mini,deepSeek-v3,grok-3

# AWS Bedrock configuration - will be configured via setup.sh
AWS_REGION=us-west-2
AWS_MODEL_LIST=us.anthropic.claude-3-7-sonnet-20250219-v1:0

# ===========================
# ====== Preset config ====== 
# ===========================
# if no special requirements, no need to change
LOBE_PORT=3210
CASDOOR_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_PORT=5432
LOGTO_API_PORT=3001
LOGTO_ADMIN_PORT=3002
APP_URL=https://nonprod-vibgpt.vib
AUTH_URL=https://nonprod-vibgpt.vib/api/auth
NEXTAUTH_URL=https://nonprod-vibgpt.vib

# Postgres related, which are the necessary environment variables for DB
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=uWNZugjBqixf8dxC

# Auth configuration
AUTH_CASDOOR_ISSUER=https://auth.nonprod-vibgpt.vib
AUTH_CASDOOR_ID=a387a4892ee19b1a2249
AUTH_CASDOOR_SECRET=38a2af8fee5ab66bd51c81d090480da7

# MinIO S3 configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=bcb14a98

# Configure the bucket information of MinIO
S3_PUBLIC_DOMAIN=https://minio.nonprod-vibgpt.vib
S3_ENDPOINT=https://minio.nonprod-vibgpt.vib
MINIO_LOBE_BUCKET=lobe

# Feature flags - will be configured via setup.sh
# FEATURE_FLAGS=

# Configure for casdoor
origin=https://auth.nonprod-vibgpt.vib

# Files configuration - will be configured via setup.sh
DEFAULT_FILES_CONFIG="embedding_model=azure/text-embedding-ada-002,query_mode=full_text"
DEFAULT_EMBEDDING_PROVIDER=azure
AZURE_API_KEY=your_azure_api_key_here
AZURE_ENDPOINT=https://your-resource.openai.azure.com
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
FEATURE_FLAGS=-welcome_suggest,+webrtc_sync,+dalle,+search_engine,+rag_eval,+pin_list