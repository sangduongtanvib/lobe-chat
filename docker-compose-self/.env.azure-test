# Postgres related
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=uWNZugjBqixf8dxC

AUTH_CASDOOR_ISSUER=http://localhost:8000
AUTH_CASDOOR_ID=a387a4892ee19b1a2249
AUTH_CASDOOR_SECRET=dbf205949d704de81b0b5b3603174e23fbecc354

# Azure Storage configuration (instead of MinIO/S3)
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT_NAME=lobechattest123
AZURE_STORAGE_ACCOUNT_KEY=your_azure_storage_key_here
AZURE_STORAGE_CONTAINER_NAME=lobe

# Feature flags
FEATURE_FLAGS=-welcome_suggest,+webrtc_sync,+dalle,+search_engine,+rag_eval,+pin_list

# Configure for casdoor
origin=http://localhost:8000
ENABLED_OPENAI=0
ENABLED_OLLAMA=0
ENABLED_AZUREAI=1
ENABLED_ANTHROPIC=0
ENABLED_GOOGLE=0
ENABLED_AWS_BEDROCK=1

# Default agent config
DEFAULT_AGENT_CONFIG="model=gpt-4o;plugins=search-engine"
SYSTEM_AGENT="default=azure/gpt-4o-mini"

# Azure AI configuration (for LLM)
AZURE_API_VERSION=2024-05-01-preview
AZURE_MODEL_LIST=gpt-4o->gpt-4o=GPT 4o,gpt-4o-mini->gpt-4o-mini=GPT 4o mini

# Other preset configs
LOBE_PORT=3210
CASDOOR_PORT=8000
POSTGRES_PORT=5432
APP_URL=http://localhost:3210
AUTH_URL=http://localhost:3210/api/auth
NEXTAUTH_URL=http://localhost:3210
