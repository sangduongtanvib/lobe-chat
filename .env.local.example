# LobeChat Local Environment Configuration
# This file contains your actual secrets and should NEVER be committed to git
# Copy this file to .env.local and fill in your real values

# ===========================================
# 🔑 AZURE OPENAI CONFIGURATION
# ===========================================
# Get these from Azure Portal > Cognitive Services > Your OpenAI resource
AZURE_API_KEY=your_real_azure_openai_api_key_here
AZURE_ENDPOINT=https://your-actual-resource-name.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview

# ===========================================
# 🗄️ DATABASE CONFIGURATION  
# ===========================================
# Your actual database connection string
DATABASE_URL=postgres://your_real_user:your_real_password@your_real_host:5432/your_real_database
POSTGRES_PASSWORD=your_real_postgres_password
LOBE_DB_NAME=your_actual_db_name

# ===========================================
# 📦 AZURE BLOB STORAGE CONFIGURATION
# ===========================================
# Set this to 'azure' to use Azure Blob Storage
STORAGE_PROVIDER=azure

# Method 1: Connection String (Recommended)
# Get from Azure Portal > Storage Account > Access Keys
AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=YOUR_ACTUAL_ACCOUNT;AccountKey=YOUR_ACTUAL_KEY;EndpointSuffix=core.windows.net"
AZURE_BLOB_CONTAINER_NAME=your_actual_container_name

# Method 2: Separate Account Details (Alternative)
# AZURE_STORAGE_ACCOUNT_NAME=your_actual_storage_account
# AZURE_STORAGE_ACCOUNT_KEY=your_actual_storage_key  
# AZURE_STORAGE_CONTAINER_NAME=your_actual_container

# ===========================================
# 🔐 AUTHENTICATION SECRETS
# ===========================================
APP_URL=http://localhost:3010
NEXTAUTH_URL=https://your-actual-domain.com/api/auth
NEXTAUTH_SECRET=your_actual_nextauth_secret_generate_a_long_random_string
KEY_VAULTS_SECRET=your_actual_key_vault_secret

# ===========================================
# 🎛️ APPLICATION SETTINGS
# ===========================================
ENABLE_VERCEL_ANALYTICS=1
NEXT_PUBLIC_SERVICE_MODE=server
DEFAULT_EMBEDDING_PROVIDER=azure
NEXT_PUBLIC_CDN_USE_GLOBAL=0

# File and Search Configuration
DEFAULT_FILES_CONFIG="embedding_model=azure/text-embedding-ada-002,reranker_model=cohere/rerank-english-v3.0,query_mode=full_text"
SEARXNG_URL=https://your-search-engine.com
FEATURE_FLAGS=-welcome_suggest,+webrtc_sync,+dalle,+search_engine,+rag_eval,+pin_list

# Storage Settings
NEXT_PUBLIC_S3_FILE_PATH=files
CHUNKS_AUTO_EMBEDDING=0
CHUNKS_AUTO_GEN_METADATA=0
S3_PREVIEW_URL_EXPIRE_IN=7200
S3_SET_ACL=0
S3_ENABLE_PATH_STYLE=0

# ===========================================
# 🚨 SECURITY REMINDER
# ===========================================
# NEVER commit this file to git!
# Add .env.local to .gitignore
# Generate strong, unique secrets for production
