# SSL Configuration for Docker Container
# Add these environment variables to fix SSL errors

# Node.js SSL Configuration
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_EXTRA_CA_CERTS=""
SSL_CERT_DIR="/etc/ssl/certs/ca-certificates.crt"

# Next.js Configuration  
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# Application Configuration
HOSTNAME=0.0.0.0
PORT=3210

# SSL Debug (set to 1 for debugging)
NODE_DEBUG_SSL=0
NODE_OPTIONS="--dns-result-order=ipv4first --use-openssl-ca"

# Service Worker Configuration
NEXT_PUBLIC_SERVICE_WORKER_ENABLED=false

# WAF Configuration
WAF_ENABLE_SERVICE_WORKER=false
WAF_DEBUG_MODE=false 